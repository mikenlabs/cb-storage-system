# ── Supabase (create a free project at https://supabase.com) ──
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-secret-key

# Storage bucket name (must match migration 002, default is fine)
STORAGE_BUCKET=hub-storage

# Backup schedule fallback — only used until an admin saves a
# schedule from the Backup & Recovery page in the app.
BACKUP_SCHEDULE_ENABLED=true
BACKUP_SCHEDULE_HOUR=2
BACKUP_SCHEDULE_MINUTE=0

# Keep false in production
FLASK_DEBUG=false
